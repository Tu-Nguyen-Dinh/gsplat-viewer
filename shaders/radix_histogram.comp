#version 430 core
// Radix sort, step 1: per-block histogram of the current digit.
// Output layout is DIGIT-MAJOR: blockHist[digit * numBlocks + block]. An exclusive
// prefix sum over that array then directly gives, for every (digit, block), the
// global position where this block's keys with that digit must be written.
#include "include/radix_common.glsl"

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer KeysIn { uint keysIn[]; };
layout(std430, binding = 4) writeonly buffer BlockHist { uint blockHist[]; };

shared uint sHist[RADIX_BUCKETS];

void main() {
    uint t = gl_LocalInvocationID.x;
    uint block = gl_WorkGroupID.x;
    if (t < RADIX_BUCKETS) sHist[t] = 0u;
    barrier();

    uint n = elementCount();
    for (uint r = 0u; r < RADIX_ROUNDS; ++r) {
        uint i = block * RADIX_BLOCK + r * RADIX_THREADS + t;
        if (i < n) atomicAdd(sHist[digitOf(keysIn[i])], 1u);  // shared-memory atomics are cheap
    }
    barrier();

    if (t < RADIX_BUCKETS) blockHist[t * uNumBlocks + block] = sHist[t];
}
