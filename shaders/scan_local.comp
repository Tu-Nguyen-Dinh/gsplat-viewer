#version 430 core
// Exclusive prefix sum (scan) of 512 elements per work group, in place.
// Blelloch's work-efficient algorithm: an up-sweep builds partial sums in a
// balanced tree, a down-sweep distributes them back. The total of each block is
// written to sums[] so a second level can scan the block totals.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Data { uint data[]; };
layout(std430, binding = 1) writeonly buffer Sums { uint sums[]; };
uniform uint uCount;

shared uint s[512];

void main() {
    uint t = gl_LocalInvocationID.x;
    uint base = gl_WorkGroupID.x * 512u;
    uint a = base + 2u * t, b = a + 1u;
    s[2u * t] = a < uCount ? data[a] : 0u;
    s[2u * t + 1u] = b < uCount ? data[b] : 0u;

    // Up-sweep (reduce): after it, s[511] holds the block total.
    uint offset = 1u;
    for (uint d = 256u; d > 0u; d >>= 1u) {
        barrier();
        if (t < d) {
            uint ai = offset * (2u * t + 1u) - 1u;
            uint bi = offset * (2u * t + 2u) - 1u;
            s[bi] += s[ai];
        }
        offset <<= 1u;
    }
    barrier();
    if (t == 0u) {
        sums[gl_WorkGroupID.x] = s[511];
        s[511] = 0u;   // exclusive scan: the first element receives 0
    }

    // Down-sweep: push prefix sums back down the tree.
    for (uint d = 1u; d < 512u; d <<= 1u) {
        offset >>= 1u;
        barrier();
        if (t < d) {
            uint ai = offset * (2u * t + 1u) - 1u;
            uint bi = offset * (2u * t + 2u) - 1u;
            uint tmp = s[ai];
            s[ai] = s[bi];
            s[bi] += tmp;
        }
    }
    barrier();
    if (a < uCount) data[a] = s[2u * t];
    if (b < uCount) data[b] = s[2u * t + 1u];
}
