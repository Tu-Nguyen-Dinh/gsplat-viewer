#version 430 core
// Second level of the scan: add the (already scanned) total of all previous
// blocks to every element of this 512-element block.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Data { uint data[]; };
layout(std430, binding = 1) readonly buffer Sums { uint sums[]; };
uniform uint uCount;

void main() {
    uint t = gl_LocalInvocationID.x;
    uint base = gl_WorkGroupID.x * 512u;
    uint add = sums[gl_WorkGroupID.x];
    uint a = base + 2u * t, b = a + 1u;
    if (a < uCount) data[a] += add;
    if (b < uCount) data[b] += add;
}
