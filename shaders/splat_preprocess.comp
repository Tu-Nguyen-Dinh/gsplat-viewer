#version 430 core
// Pass 1 of the splat pipeline, one invocation per Gaussian:
//   project the 3D Gaussian to a 2D ellipse (EWA), evaluate its color for this view,
//   cull it if invisible, and append visible splats to the draw list.
#include "include/splat_buffers.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = BINDING_SPLATS)    readonly buffer Splats    { GpuSplat splats[]; };
layout(std430, binding = BINDING_SH_REST)   readonly buffer ShRest    { uint shData[]; };
layout(std430, binding = BINDING_PROJECTED) writeonly buffer Projected { ProjectedSplat projected[]; };
layout(std430, binding = BINDING_ORDER)     writeonly buffer Order     { uint order[]; };
layout(std430, binding = BINDING_DRAW_CMD)  buffer DrawCmd   { DrawCommand drawCmd; };
layout(std430, binding = BINDING_SORT_KEYS) writeonly buffer SortKeys  { uint sortKeys[]; };

#include "include/gaussian.glsl"
#include "include/spherical_harmonics.glsl"

uniform uint uCount;
uniform mat4 uView;          // view * model
uniform vec2 uViewport;
uniform vec2 uFocal;
uniform vec2 uTanHalfFov;
uniform float uNear;
uniform float uSplatScale;
uniform int uCull;
uniform vec3 uCameraPos;     // in model space (SH directions are defined there)
uniform int uShDegree;
uniform uint uRestPerChannel;
uniform uint uShStride;      // uints per splat in shData (45 for float32, 23 for float16)
uniform vec2 uDepthRange;    // (min, 1 / (max - min)) for 16-bit sort keys
uniform int uKeyBits;        // 16 or 32

// Sort key such that ASCENDING order = FAR to NEAR (back-to-front drawing).
uint depthKey(float depth) {
    if (uKeyBits == 16) {
        float t = clamp((depth - uDepthRange.x) * uDepthRange.y, 0.0, 1.0);
        return 0xFFFFu - uint(t * 65535.0);
    }
    // For positive floats the IEEE-754 bit pattern increases with the value.
    return 0xFFFFFFFFu - floatBitsToUint(depth);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;

    GpuSplat s = splats[i];
    Projection p = projectGaussian(s.positionOpacity.xyz, unpackCovariance(s.cov0, s.cov1), uView, uViewport,
                                   uFocal, uTanHalfFov, uNear, uSplatScale, uCull != 0);
    if (!p.visible || s.positionOpacity.w < 1.0 / 255.0) {
        projected[i].centerDepthRadius = vec4(0.0);
        return;
    }

    vec3 dir = normalize(s.positionOpacity.xyz - uCameraPos);
    vec3 color = evalSphericalHarmonics(uShDegree, dir, s.dc.rgb, i * uShStride, uRestPerChannel);

    projected[i].centerDepthRadius = vec4(p.center, p.depth, p.radius);
    projected[i].conicOpacity = vec4(p.conic, s.positionOpacity.w);
    projected[i].axes = vec4(p.axisMajor, p.axisMinor);
    projected[i].color = vec4(color, 1.0);

    // Append to the visible list. The counter doubles as the instance count of the indirect draw.
    uint slot = atomicAdd(drawCmd.instanceCount, 1u);
    order[slot] = i;
    sortKeys[slot] = depthKey(p.depth);
}
