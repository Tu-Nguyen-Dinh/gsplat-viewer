#version 430 core
// Pass 1 of the splat pipeline, one invocation per Gaussian:
//   decode the splat, project the 3D Gaussian to a 2D ellipse (EWA), evaluate its color for this
//   view, cull it if invisible, and append visible splats to the draw list.
#include "include/splat_buffers.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = BINDING_SPLATS)    readonly buffer Splats    { GpuSplat splats[]; };
layout(std430, binding = BINDING_PACKED)    readonly buffer Packed    { uint packedWords[]; };
layout(std430, binding = BINDING_CHUNKS)    readonly buffer Chunks    { vec4 chunkBounds[]; };
layout(std430, binding = BINDING_SH_REST)   readonly buffer ShRest    { uint shData[]; };
layout(std430, binding = BINDING_PROJECTED) writeonly buffer Projected { ProjectedSplat projected[]; };
layout(std430, binding = BINDING_ORDER)     writeonly buffer Order     { uint order[]; };
layout(std430, binding = BINDING_DRAW_CMD)  buffer DrawCmd   { DrawCommand drawCmd; };
layout(std430, binding = BINDING_SORT_KEYS) writeonly buffer SortKeys  { uint sortKeys[]; };

#include "include/gaussian.glsl"
#include "include/spherical_harmonics.glsl"
#include "include/splat_codec.glsl"

uniform uint uCount;
uniform int uCompressed;     // 1: packedWords + chunkBounds (24 B / splat), 0: splats[] (64 B)
uniform mat4 uView;          // view * model
uniform vec2 uViewport;
uniform vec2 uFocal;
uniform vec2 uPrincipal;  // principal point in pixels
uniform vec2 uTanHalfFov;
uniform float uNear;
uniform float uSplatScale;
uniform int uCull;
uniform vec3 uCameraPos;     // in model space (SH directions are defined there)
uniform int uShDegree;
uniform uint uRestPerChannel;
// (uShCount, the plane stride of shData, is declared in spherical_harmonics.glsl)
uniform vec2 uDepthRange;    // (min, 1 / (max - min)) for 16-bit sort keys
uniform int uKeyBits;        // 16, 24 or 32

// Sort key such that ASCENDING order = FAR to NEAR (back-to-front drawing).
uint depthKey(float depth) {
    if (uKeyBits == 16) {   // linear in the scene's depth range: depths outside it are clamped
        float t = clamp((depth - uDepthRange.x) * uDepthRange.y, 0.0, 1.0);
        return 0xFFFFu - uint(t * 65535.0);
    }
    // For positive floats the IEEE-754 bit pattern increases with the value.
    uint key = 0xFFFFFFFFu - floatBitsToUint(depth);
    // 24 bits: drop the 8 lowest mantissa bits. Still floating point, so no range and no
    // clamping; relative precision 2^-15 (0.15 mm at 5 m) with 6 radix passes instead of 8.
    return uKeyBits == 24 ? key >> 8 : key;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;

    vec3 mean, dc;
    float opacity;
    mat3 cov;
    if (uCompressed != 0) {
        // 24 bytes instead of 64: the covariance is rebuilt from scale + rotation (a few dozen
        // flops), which is cheaper than reading 40 more bytes per splat every frame.
        uint b = 6u * i, c = 2u * (i / kCodecChunk);
        DecodedSplat d = decodeSplat(packedWords[b], packedWords[b + 1u], packedWords[b + 2u], packedWords[b + 3u],
                                     packedWords[b + 4u], packedWords[b + 5u], chunkBounds[c].xyz,
                                     chunkBounds[c + 1u].xyz);
        mean = d.position;
        opacity = d.opacity;
        dc = d.dc;
        cov = covarianceFromScaleRotation(d.scale, d.rotation);
    } else {
        GpuSplat s = splats[i];
        mean = s.positionOpacity.xyz;
        opacity = s.positionOpacity.w;
        dc = s.dc.rgb;
        cov = unpackCovariance(s.cov0, s.cov1);
    }

    Projection p = projectGaussian(mean, cov, uView, uViewport, uFocal, uPrincipal, uTanHalfFov, uNear, uSplatScale,
                                   uCull != 0);
    if (!p.visible || opacity < 1.0 / 255.0) {
        projected[i].bits = uvec4(0u);  // w == 0: culled (only read with CPU ordering)
        return;
    }

    vec3 dir = normalize(mean - uCameraPos);
    vec3 color = evalSphericalHarmonics(uShDegree, dir, dc, i, uRestPerChannel);

    // 32 bytes: center and conic in fp32 (pixel positions need it), color and opacity in fp16.
    projected[i].centerConic = vec4(p.center, p.conic.xy);
    projected[i].bits = uvec4(floatBitsToUint(p.conic.z), floatBitsToUint(p.depth), packHalf2x16(color.rg),
                              packHalf2x16(vec2(color.b, opacity)));

    // Append to the visible list. The counter doubles as the instance count of the indirect draw.
    uint slot = atomicAdd(drawCmd.instanceCount, 1u);
    order[slot] = i;
    sortKeys[slot] = depthKey(p.depth);
}
