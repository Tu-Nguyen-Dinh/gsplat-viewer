<?xml version="1.0" encoding="utf-8"?>
<!-- gsplat-viewer for Android: a NativeActivity app (all code in libgsplat_android.so). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gsplatviewer.app">

  <!-- Talks to gsplat_server on the PC (same Wi-Fi) to download trained scenes. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- OpenGL ES 3.1: compute shaders, storage buffers in vertex shaders, indirect draws. -->
  <uses-feature android:glEsVersion="0x00030001" android:required="true" />

  <application
      android:label="gsplat-viewer"
      android:hasCode="false"
      android:extractNativeLibs="true"
      android:requestLegacyExternalStorage="false">
    <activity
        android:name="android.app.NativeActivity"
        android:exported="true"
        android:screenOrientation="sensorLandscape"
        android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
      <meta-data android:name="android.app.lib_name" android:value="gsplat_android" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
